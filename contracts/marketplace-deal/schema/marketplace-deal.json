    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "description": "Immutable terms for one isolated Host/epoch deal.",
    "type": "object",
    "required": [
      "buyer_budget_micro_usdt",
      "factory",
      "fee_bps",
      "fee_recipient",
      "host",
      "pinned_gonka_sha",
      "price_micro_usdt_per_gnk",
      "settlement_cw20",
      "target_epoch"
